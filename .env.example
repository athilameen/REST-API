# Server
PORT=3000

# MongoDB Atlas
# Connection string is built as:
# mongodb+srv://<MONGO_DB_USER>:<MONGO_DB_PW>@<MONGO_DB_CLS>.mongodb.net/<MONGO_DB>
MONGO_DB_USER=
MONGO_DB_PW=
MONGO_DB_CLS=
MONGO_DB=

# Redis (auth/session state)
REDIS_HOST=
REDIS_PORT=
REDIS_PW=
REDIS_EXPIRES_IN=        # TTL (seconds) for the userState session key

# JWT
JWT_SECRET=
JWT_ACCESS_TOKEN_EXPIRES_IN=     # e.g. 15m
JWT_REFRESH_TOKEN_EXPIRES_IN=    # e.g. 7d

# AWS S3 (product image uploads)
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET_NAME=

# Email (password reset via Gmail)
GMAIL_ID=
GMAIL_PASS=
MAIL_FROM=
APP_URL=                 # Base URL used to build the password-reset link

# Password reset
RESET_PASSWORD_EXPIRES_IN=       # Token validity window in ms (e.g. 3600000 = 1 hour)
